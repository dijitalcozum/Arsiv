+/**
+ * On a yes, the full-screen video viewer's comment bar returns no rendered object. Insert the
+ * check immediately before each object return, so every normal return path is covered without
+ * guessing which register Facebook uses for the composer. A free local register below v16 is
+ * needed by if-eqz; refuse to patch if there isn't one.
+ */
+internal fun MutableMethod.hideVideoCommentComposer() {
+    if (!returnType.startsWith("L") && !returnType.startsWith("[")) {
+        refuse("$descriptor() doesn't return an object")
+    }
+    val original = implementation?.instructions?.toList().orEmpty()
+    val returns = original.indices.filter { original[it].opcode == Opcode.RETURN_OBJECT }
+    if (returns.isEmpty()) refuse("$descriptor() has no return-object instruction")
+
+    // Insert from the end so the original indices before each insertion remain valid.
+    for (index in returns.asReversed()) {
+        val code = implementation!!.instructions
+        val returnedRegister = (code[index] as? OneRegisterInstruction)?.registerA
+            ?: refuse("$descriptor() has a return-object without a register")
+        val live = RegisterLiveness.of(this).liveInto(index)
+        val free = (0 until minOf(localRegisterCount(), 16))
+            .firstOrNull { it !in live && it != returnedRegister }
+            ?: refuse("$descriptor() has no free low register before return at instruction $index")
+        val clear = if (returnedRegister < 16) {
+            "const/4 v$returnedRegister, 0x0"
+        } else {
+            "const/16 v$returnedRegister, 0x0"
+        }
+        addInstructionsWithLabels(
+            index,
+            """
+                invoke-static {}, $HIDES_VIDEO_COMMENT_COMPOSER
+                move-result v$free
+                if-eqz v$free, :keep$index
+                $clear
+            """,
+            ExternalLabel("keep$index", getInstruction(index)),
+        )
+    }
+}
